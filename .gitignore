# --- Unreal Engine generated (never tracked) ---
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/

# Plugin-generated
Plugins/**/Binaries/
Plugins/**/Intermediate/

# --- IDE / toolchain ---
# Regenerate via right-click .uproject -> Generate Project Files
*.sln
*.xcworkspace
*.xcodeproj
.vs/
.vscode/
.idea/
*.code-workspace

# Rider
*.DotSettings.user

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Python tooling ---
# Unreal's embedded interpreter writes these when a Tools/Python script
# imports a sibling module.
__pycache__/
*.pyc

# --- Local-only config ---
Config/UserEngine.ini
Config/UserGame.ini
